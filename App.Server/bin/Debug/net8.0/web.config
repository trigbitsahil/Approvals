<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
    <security>
      <requestFiltering>
        <!-- Increase maxUrl and maxQueryString to support long tokens (16KB) -->
        <requestLimits maxUrl="16384" maxQueryString="16384" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
